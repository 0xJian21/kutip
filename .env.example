# Kutip environment. Copy to .env at the repo root; never commit real values.
# Who reads what: [web] apps/web (Vercel) · [worker] apps/worker (Fly.io) · [scripts] one-shot scripts

# ---- Solana / Solami (https://solami.dev → dashboard → API key) ----
SOLANA_CLUSTER=mainnet-beta
# [web][worker][scripts]
SOLAMI_API_KEY=
# [web][worker][scripts] Solami RPC URL from the dashboard
SOLAMI_RPC_URL=
# [worker] e.g. https://grpc.solami.dev (the key is sent as the x-token header)
SOLAMI_GRPC_URL=
# [worker] optional; defaults to SOLAMI_API_KEY
SOLAMI_GRPC_KEY=
# unused on the demo path
SOLAMI_SWQOS_KEY=
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ---- Keys (base58 64-byte secret keys) ----
# [web][scripts] pays every network fee; keep a small SOL float
FEE_PAYER_SECRET=
# [worker] low-balance alert only; the worker never needs the secret
FEE_PAYER_PUBKEY=
# [scripts] Squads member with Initiate permission + spending limits
AGENT_SECRET=
# [scripts] demo buyer / AP bot wallet
TEST_BUYER_SECRET=

# ---- Data (Supabase → Project settings → Database / API) ----
# [web] transaction pooler (port 6543) · [worker][scripts] session pooler or direct
DATABASE_URL=
# [web] also exposed to the browser for Realtime Broadcast
SUPABASE_URL=
# [web] public; RLS gives it no table access
SUPABASE_ANON_KEY=
# unused by the apps
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth (Privy dashboard) ----
# [web]
NEXT_PUBLIC_PRIVY_APP_ID=
# [web] verifies sign-ins and signs Kutip's session cookie
PRIVY_APP_SECRET=
# [web][scripts] the demo exporter (scripts, onboarding's "Use demo details")
DEMO_EXPORTER_ID=exp_teratai
# [web] 1 = let a verified Privy user with no Kutip user into DEMO_EXPORTER_ID (off: such sign-ins are refused)
DEMO_FALLBACK=

# ---- AI ----
# [web][worker] Haiku: PDF extraction, emails, reply-classification fallback
ANTHROPIC_API_KEY=
# [web] optional: Jev (typesafe/jev-1.13 via OpenRouter) classifies buyer replies
OPENROUTER_API_KEY=
# unused (Jev runs through OpenRouter)
TYPESAFE_API_KEY=

# ---- Email (optional) ----
# [worker] without it reminders and receipts are recorded, not sent
RESEND_API_KEY=
EMAIL_FROM="Kutip <onboarding@resend.dev>"

# ---- App ----
# [web][worker] the public https origin in production (wallets fetch the Solana Pay icon from it)
APP_URL=http://localhost:3000
# [web] false = USDC only (turns off Jupiter SOL/USDT swaps)
PAYMENTS_SOL_ENABLED=true
# [web] optional; Jupiter Swap API v1 works keyless at a low rate
JUPITER_API_KEY=
# [web] 1 = show "Simulate a reply" on invoice pages in a production build
NEXT_PUBLIC_DEMO_CONTROLS=
# [web] 1 = offline UI on mock data (no DB, no auth)
NEXT_PUBLIC_KUTIP_MOCK=

# ---- Worker ----
# [worker] on | dry | off (dry logs reminders and writes nothing)
COLLECTIONS=dry
# [worker] low-balance alert floor (0.01 SOL)
FEE_PAYER_MIN_LAMPORTS=10000000
# [worker] health check: GET /health
PORT=8080
